---
// The markup below renders during the static build. All dynamic behavior and
// every browser API (localStorage, document, window) lives in the client-side
// <script> at the bottom, which Astro runs only in the browser, never at build
// time. Pure logic is in src/lib/bookmarks.ts.
---
<form id="add-bookmark" novalidate>
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      aria-describedby="form-error"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="form-error" class="error" role="alert" hidden></p>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<style is:global>
  form#add-bookmark {
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    box-shadow: 0 1px 2px #0001;
  }
  .error { margin: 0 0 0.75rem; font-size: 0.85rem; color: #dc2626; }
  li.bookmark { transition: border-color 0.15s, transform 0.15s; }
  li.bookmark:hover { border-color: var(--accent); transform: translateY(-1px); }
  .bookmark .url { color: var(--accent); text-decoration: none; }
  .bookmark .url:hover { text-decoration: underline; }
  .bookmark .sep { color: var(--muted); white-space: pre; }
  .bookmark .slug {
    font-family: var(--font-body);
    font-weight: 600;
  }
  .bookmark .copy:hover { border-color: currentColor; }
</style>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  import {
    STORAGE_KEY,
    SEPARATOR,
    parseStored,
    serialize,
    addBookmark,
    type Bookmark,
  } from '../lib/bookmarks';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  function load(): Bookmark[] {
    try {
      return parseStored(window.localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function save(list: Bookmark[]): boolean {
    try {
      window.localStorage.setItem(STORAGE_KEY, serialize(list));
      return true;
    } catch {
      return false;
    }
  }

  let bookmarks: Bookmark[] = [];

  function showError(message: string) {
    const el = $('form-error');
    if (!el) return;
    el.textContent = message;
    el.hidden = !message;
  }

  function render() {
    const list = $('bookmark-list');
    if (!list) return;
    list.replaceChildren();
    for (const b of bookmarks) {
      const li = document.createElement('li');
      li.className = 'bookmark';

      const a = document.createElement('a');
      a.className = 'url';
      a.href = b.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = b.url;

      const sep = document.createElement('span');
      sep.className = 'sep';
      sep.textContent = SEPARATOR;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = b.slug;

      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'copy';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.slug);
          copy.textContent = 'Copied!';
        } catch {
          copy.textContent = 'Copy failed';
        }
        setTimeout(() => (copy.textContent = 'Copy'), 1500);
      });

      li.append(a, sep, slug, copy);
      list.append(li);
    }
    const empty = $('empty-state');
    const header = $('list-header');
    if (empty) empty.hidden = bookmarks.length > 0;
    if (header) header.hidden = bookmarks.length === 0;
  }

  function init() {
    const form = $<HTMLFormElement>('add-bookmark');
    const input = $<HTMLInputElement>('url');

    // Registered before anything that could throw, with preventDefault first,
    // so a JS error can never fall back to a native submit/reload.
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      try {
        showError('');
        const next = addBookmark(bookmarks, input?.value);
        if (!next) {
          showError('Enter a valid link, like example.com or https://example.com.');
          input?.focus();
          return;
        }
        bookmarks = next;
        if (!save(bookmarks)) showError('Could not save to this browser, so it may not persist.');
        render();
        if (input) input.value = '';
      } catch {
        showError('Something went wrong adding that bookmark. Please try again.');
      }
    });

    $('clear-all')?.addEventListener('click', () => {
      try {
        if (!window.confirm('Remove all saved bookmarks?')) return;
        bookmarks = [];
        try {
          window.localStorage.removeItem(STORAGE_KEY);
        } catch {
          // storage unavailable; in-memory list is already cleared
        }
        render();
      } catch {
        showError('Could not clear bookmarks.');
      }
    });

    try {
      bookmarks = load();
      render();
    } catch {
      bookmarks = [];
    }
  }

  init();
</script>
